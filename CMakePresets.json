{
    "version": 10,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "release-x86",
            "inherits": "base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            }
        },
        {
            "name": "release-x64",
            "inherits": "base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        }
    ]
}